# Normalize to LF in the repository; Git checks out native line endings.
* text=auto

*.php   text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.xml   text eol=lf
*.svg   text eol=lf
*.txt   text eol=lf
.htaccess text eol=lf

# Binary — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff  binary
*.woff2 binary
